        "random_behavior",
        "item_interaction"
      ]
    },
    {
      "id": "oldpine.clearing",
      "source_path": "mudlib/d/oldpine/clearing.c",
      "status": "verified",
      "name": "林间空地",
      "description": "这是一块林间空地，四周的树木花草像是被人修剪过一般，环绕著\n空地围成一个整齐的圆形，空地中央一株巨大的松树(pine)像平地上撑\n起一把大伞，树上针叶茂密得遮去了大半的阳光，空地四周有三条小路\n分别通往东、西、南三个方向，往南的小路旁竖著一个牌子(sign)。",
      "exits": [
        {
          "direction": "east",
          "target": "oldpine.epath1",
          "source_target": "/d/oldpine/epath1",
          "internal": true,
          "dynamic": false
        },
        {
          "direction": "north",
          "target": "oldpine.spath1",
          "source_target": "/d/oldpine/spath1",
          "internal": true,
          "dynamic": false
        },
        {
          "direction": "west",
          "target": "oldpine.npath3",
          "source_target": "/d/oldpine/npath3",
          "internal": true,
          "dynamic": false
        }
      ],
      "doors": [],
      "details": [
        {
          "key": "pine",
          "description": "一株又高又大的松树，当你抬头往上看的时候似乎有个人影\n在树梢之间移动，不过也许是风吹动所造成的错觉。",
          "door_direction": null
        },
        {
          "key": "sign",
          "description": "「官府告示：此处常有歹人出没。」",
          "door_direction": null
        }
      ],
      "object_sources": [],
      "object_placements": [],
      "behavior_flags": [
        "custom_command",
        "conditional_exit",
        "item_interaction"
      ]
