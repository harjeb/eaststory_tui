    {
      "id": "oldpine.cave5",
      "source_path": "mudlib/d/oldpine/cave5.c",
      "status": "verified",
      "name": "山洞",
      "description": "你现在已经到达山洞的深处了, 耶...东面就是洞口了, 还可以听\n见外面瀑布的水声, 仔细的观察石壁(wall), 可以发现上面有一些用利\n剑雕刻的字....",
      "exits": [
        {
          "direction": "eastdown",
          "target": "oldpine.waterfall",
          "source_target": "__DIR__waterfall",
          "internal": true,
          "dynamic": false
        }
      ],
      "doors": [],
      "details": [
        {
          "key": "wall",
          "description": "老夫南危水, 乃是昔年水烟阁五长老中第一高手,\n一生醉心武学, 集天邪、封山两派之所长, 为营救盟主遭小人暗算,\n埋骨于此。男子汉大丈夫死不足惜, 只可恨一身武学尚无传人!\n葬(bury)我遗骨者老夫将赠以过招要旨, 唉......",
          "door_direction": null
        }
      ],
      "object_sources": [
        "mudlib/d/oldpine/npc/skeleton.c"
      ],
      "object_placements": [
        {
          "source_path": "mudlib/d/oldpine/npc/skeleton.c",
          "quantity": 1
        }
      ],
