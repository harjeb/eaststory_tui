    {
      "id": "oldpine.epath2",
      "source_path": "mudlib/d/oldpine/epath2.c",
      "outdoors": "oldpine",
      "status": "verified",
      "name": "小石桥",
      "description": "你现在正站在一座长满青苔的古桥上，桥下是一条山涧，几股清泉\n在乱石之中向山下奔流，桥北边不远处有一个瀑布(waterfall) ，从山\n壁上犹如一条白练般垂了下来，瀑布两旁的石壁十分陡峭，高度和山涧\n旁的松林相差了近三、四十丈。",
      "exits": [
        {
          "direction": "east",
          "target": "oldpine.epath3",
          "source_target": "/d/oldpine/epath3",
          "internal": true,
          "dynamic": false
        },
        {
          "direction": "west",
          "target": "oldpine.epath1",
          "source_target": "/d/oldpine/epath1",
          "internal": true,
          "dynamic": false
        }
      ],
      "doors": [],
      "details": [
        {
          "key": "vine",
          "description": "其中有一根藤蔓距离你比较近，你可以试著抓住(hold)藤蔓，看看\n能不能像泰山一样荡过去，看看瀑布后面有什么？\n对了，提醒你一点，这座石桥下面是高约百丈的山涧深谷....。",
          "door_direction": null
        },
        {
          "key": "waterfall",
          "description": "这个瀑布从数百丈高的山壁上冲激而下，流入一个山涧底的小水潭\n，水潭两边的石壁垂下许多的藤蔓(vine)，你注意到瀑布后面似乎\n有什么东西在发著光。",
          "door_direction": null
        }
      ],
      "object_sources": [],
